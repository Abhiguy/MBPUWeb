datablock AudioProfile(TargetSfx)
{
   filename    = "./bell.wav";
   description = AudioDefault3d;
   preload = true;
};

datablock AudioProfile(AllTargetsSfx)
{
   filename    = "./bell2.wav";
   description = AudioDefault3d;
   preload = true;
};

datablock AudioProfile(TankMovingSfx)
{
   filename    = "./tankmoving.wav";
   description = AudioClosestLooping3d;
   preload = true;
};

datablock AudioProfile(TankFireSfx)
{
   filename    = "./tankfire.wav";
   description = AudioClosest3d;
   preload = true;
};

datablock StaticShapeData(Tank) {
   classname = "TankPart";
   category = "Tank";
   shapeFile = "./tank_base.dts";
};

datablock StaticShapeData(TankGun) {
   classname = "TankPart";
   shapeFile = "./tank_gun.dts";
};

function Tank::onAdd(%this,%obj) {
   %obj.initialTransform = %obj.getTransform();
   %obj.gun = new StaticShape() {
      position = %obj.position;
	  rotation = %obj.rotation;
	  datablock = TankGun;
   };
   MissionCleanup.add(%obj.gun);
   %obj.gun.tank = %obj;
}

function TankGun::onAdd(%this,%obj) {
   %obj.initialTransform = %obj.getTransform();
}

function TankPart::onCollision(%this,%obj,%col) {
   if (p().cantEnterTank) {
      cancel(p().tankSchedule);
	  p().tankSchedule = schedule(1000,0,"eval","p().cantEnterTank = 0;");
	  return;
   }
   if (%this.getID() == Tank.getID())
      %tank = %obj;
   else
      %tank = %obj.tank;
   %col.tank = %tank;
   enterTank();
}

datablock StaticShapeData(Boards)
{
   // Mission editor category
   category = "Hazards";
   className = "Boards";

   // Basic Item properties
   shapeFile = "./boards.dts";
   mass = 1;
   friction = 1;
   elasticity = 0.3;
   emap = false;
};

datablock StaticShapeData(Target)
{
   // Mission editor category
   category = "Hazards";
   className = "Target";

   // Basic Item properties
   shapeFile = "./target.dts";
   mass = 1;
   friction = 1;
   elasticity = 0.3;
   emap = false;
};

function Target::onAdd(%this,%obj) {
   %mat1 = "0 0 2.2 1 0 0 0";
   %mat2 = "0.565686 0 2.43432 0 1 0" SPC $pi/4;
   MissionCleanup.add(%mesh1 = new TSStatic() {
      position = "0 0 0";
      rotation = "1 0 0 0";
      scale = "0.8 0.1 0.8";
      shapeName = "~/data/shapes/colmesh.dts";
   });
   MissionCleanup.add(%mesh2 = new TSStatic() {
      position = "0 0 0";
      rotation = "1 0 0 0";
      scale = "0.8 0.1 0.8";
      shapeName = "~/data/shapes/colmesh.dts";
   });
   %mesh1.setTransform(MatrixMultiply(%obj.getTransform(),%mat1));
   %mesh2.setTransform(MatrixMultiply(%obj.getTransform(),%mat2));
   %mesh1.target = %obj;
   %mesh2.target = %obj;
   %obj.mesh1 = %mesh1;
   %obj.mesh2 = %mesh2;
   %mesh1.schedule(500,"tetherTo",%obj);
   %mesh2.schedule(500,"tetherTo",%obj);
}

