function onLoad() {
   Target1.schedule(1000,"setPath",Path1);
   Target2.schedule(1000,"setPath",Path2);
   Target3.schedule(1000,"setPath",Path3);
   Target4.schedule(1000,"setPath",Path4);
   Target5.schedule(1000,"setPath",Path5);
   Target6.schedule(1000,"setPath",Path6);
   Target7.schedule(1000,"setPath",Path7);
   Target8.schedule(1000,"setPath",Path8);
   Target9.schedule(1000,"setPath",Path9);
   Target10.schedule(1000,"setPath",Path10);
   Target11.schedule(1000,"setPath",Path11);
   Target12.schedule(1000,"setPath",Path12);
   Target13.schedule(1000,"setPath",Path13);
   Target14.schedule(1000,"setPath",Path14);
   Target15.schedule(1000,"setPath",Path15);
   Target16.schedule(1000,"setPath",Path16);
   Target17.schedule(1000,"setPath",Path17);
   Target18.schedule(1000,"setPath",Path18);
   
   Target1.schedule(2000,"setPathPosition",0);
   Target2.schedule(2000,"setPathPosition",500);
   Target3.schedule(2000,"setPathPosition",1500);
   Target4.schedule(2000,"setPathPosition",1000);
   Target5.schedule(2000,"setPathPosition",1500);
   Target6.schedule(2000,"setPathPosition",1000);
   Target7.schedule(2000,"setPathPosition",0);
   Target8.schedule(2000,"setPathPosition",500);
   Target9.schedule(2000,"setPathPosition",1500);
}

function onStep(%timeDelta) {
   if (p().tank !$= "") {
	  %drive = getKey("up")-getKey("down");
	  %turn = getKey("right")-getKey("left");
	  if (%drive != 0 || %turn != 0) {
	     if (!$tankSound) p().tank.playAudio(0,TankMovingSfx);
	     $tankSound = 1;
	  }
	  else {
	     if ($tankSound) p().tank.stopAudio(0);
	     $tankSound = 0;
	  }
	  %translate = VectorScale(MatrixRight(p().tank.getServer().getTransform()),-4*%drive*%timeDelta/1000);
	  // Yes, that should be MatrixForward, but the DTS is incorrectly rotated. I'm an idiot. :P
	  %rotate = 0.8*%turn*%timeDelta/1000;
	  %newTrans = MatrixMultiply(VectorAdd(getWords(p().tank.getServer().getTransform(),0,2),%translate) SPC
	     getWords(p().tank.getServer().getTransform(),3),"0 0 0 0 0 1" SPC %rotate);
	  // Check if the new transform isn't colliding with anything
   	  // Time for vector math!
      %n[0] = MatrixRight(%newTrans); // +x side
	  %n[1] = MatrixForward(%newTrans); // +y side
	  %n[2] = %n[0]; // -x side
	  %n[3] = %n[1]; // -y side
	  %p0[0] = MatrixMulPoint(%newTrans,"3.85 0 1.43");
	  %p0[1] = MatrixMulPoint(%newTrans,"0 1.77 1.43");
	  %p0[2] = MatrixMulPoint(%newTrans,"-4.55 0 1.43");
	  %p0[3] = MatrixMulPoint(%newTrans,"0 -1.77 1.43");
	  %good = 1;
	  %rays = 100; // Number of raycasts to use to test
	  for (%a = 0; %a < 2*$pi; %a += 2*$pi/%rays) {
		 %l0 = MatrixMulPoint(%newTrans,"0 0 0.8");
		 %l = MatrixMulVector(%newTrans,MatrixMulVector("0 0 0 0 0 1" SPC %a,"0 1 0"));
		 for (%i = 0; %i < 4; %i++) {
		    %d[%i] = VectorDot(VectorSub(%p0[%i],%l0),%n[%i])/VectorDot(%l,%n[%i]);
			if (%d[%i] < 0) %d[%i] = 999;
		 }
		 %thed = min(min(%d[0],%d[1]),min(%d[2],%d[3]));
		 %int = VectorAdd(%l0,VectorScale(%l,%thed));
		 // %int is where the ray will hit the outside of the oriented bounding box
		 // Cast the ray!
		 %flags = $TypeMasks::InteriorObjectType | $TypeMasks::StaticShapeObjectType;
		 %cast = ContainerRayCast(%l0,%int,%flags,p().tank);
		 if (%cast) {
		    %good = 0;
			user("initial pos" SPC %l0);
			user("ray" SPC %l);
			user(%d[0] SPC %d[1] SPC %d[2] SPC %d[3]);
			user("final pos" SPC %int);
	     }
	  }
	  if (%good) {
	     p().tank.getServer().setTransform(MatrixMultiply(VectorAdd(getWords(p().tank.getServer().getTransform(),0,2),%translate) SPC
	        getWords(p().tank.getServer().getTransform(),3),"0 0 0 0 0 1" SPC %rotate));
	     // $mvYaw += %rotate;
		 // $marbleYaw += %rotate;
	  }
	  p().tank.gun.getServer().setTransform(getWords(p().tank.getServer().getTransform(),0,2) SPC "0 0 1" SPC ($marbleYaw+$pi/2));
      findRealMarble().setTransform(VectorAdd(getWords(p().tank.getServer().getTransform(),0,2),"0 0 2.5") SPC "1 0 0 0");
	  
	  if (getKey("use") && !p().cantFire) {
	     // FIRE!
		 p().cantFire = 1;
		 schedule(250,0,"eval","p().cantFire = 0;");
		 %origin = getWords(p().tank.gun.getServer().getTransform(),0,2);
		 %ang = $marbleYaw-$pi/2;
         %dif = VectorRotate("1 0 0","0 0 1",-%ang);
		 serverPlay2d(TankFireSfx);
         %bullet = new StaticShape () {
            datablock = "Bullet";
            position = VectorAdd(%origin,getWords(VectorScale(%dif,5),0,1) SPC 2.3);
            rotation = "0 0 1" SPC (%ang*180/$pi);
            scale = "1 1 1";
            aimAngle = -%ang;
         };
         %bullet.creator = p().tank.gun;
	  }
	  
	  if (getKey("jump")) {
	     exitTank();
	  }
   }
   else
      $tankSound = 0;
}

function onUnload() {
   if (p().tank !$= "")
      exitTank();
   enableAll();
   resetMovement();
   HUD_ShowGem.orbitDistance = "1.46368";
}

function enterTank() {
   disable("up");
   disable("left");
   disable("right");
   disable("down");
   disable("jump");
   disable("use");
   $mvTriggerCount1++;
   findRealMarble().applyVelocity("0 0 0",VectorScale($marbleVelocity,-1));
   %p = LocalClientConnection.player;
   $tankGrav = %p.getDatablock().gravity;
   %p.getDatablock().gravity = 0;
}

function exitTank() {
   if ($tankSound) p().tank.stopAudio(0);
   $tankSound = 0;
   enableAll();
   $mvTriggerCount1++;
   p().getDatablock().gravity = $tankGrav;
   findRealMarble().setTransform(VectorAdd(getWords(p().tank.getServer().getTransform(),0,2),"0 0 4"));
   resetSpin();
   findRealMarble().applyVelocity("0 0 0","0 0 10");
   p().tank = "";
   p().cantEnterTank = 1;
   p().tankSchedule = schedule(1000,0,"eval","p().cantEnterTank = 0;");
   schedule(100,0,"resetMovement");
}

function exitTankSpawn() {
   if ($tankSound) p().tank.stopAudio(0);
   $tankSound = 0;
   enableAll();
   $mvTriggerCount1++;
   p().getDatablock().gravity = $tankGrav;
   p().tank = "";
   p().cantEnterTank = 1;
   p().tankSchedule = schedule(1000,0,"eval","p().cantEnterTank = 0;");
   schedule(100,0,"resetMovement");
   p().setPosition(LocalClientConnection.getCheckpointPos(),0.45);
}

// This is totally copied from Project Dragon, so I apologize if it's a blatant copy of the snowball

datablock StaticShapeData(Bullet)
{
   className = "Explosive";
   category = "Hazards";
   shapeFile = "./bullet.dts";
   explosion = BulletExplosion;
   renderWhenDestroyed = false;
   resetTime = 5000;
   //used for moving platform collisions
   isBullet = true;
};

function Bullet::onAdd(%this, %obj)
{
   schedule($pref::stepTime,0,"updateBullet",%obj);
   %obj.delSched = %obj.schedule(5000,"delete");
}

function Bullet::onCollision(%this, %obj, %col)
{
   %obj.setDamageState("Destroyed");
   %obj.startFade(0, 0, true);
   cancel(%obj.delSched);
   %obj.schedule(100,"delete");
}

$stepTime = 20;

function updateBullet(%obj)
{
   if (isObject(%obj)) schedule($stepTime,0,"updateBullet",%obj);
   else return;
   %origin = %obj.position;
   %scale = 2*$stepTime/50;
   %dif = %scale*mCos(%obj.aimAngle) SPC %scale*mSin(%obj.aimAngle) SPC 0;
   %pos = VectorAdd(%origin,%dif);
   %obj.setTransform(%pos SPC "1 0 0" SPC %obj.aimAngle);
   if ((%col = getWord(ContainerRayCast(%origin,VectorAdd(%origin,VectorScale(%dif,2)),$TypeMasks::StaticTSObjectType),0)) != 0) {
      if (%col.target !$= "") {
		 %obj.setDamageState("Destroyed");
		 //echo(%col);
		 %obj.startFade(0, 0, true);
		 cancel(%obj.delSched);
		 %obj.schedule(100,"delete");
	     %for = MatrixForward(%col.target.getTransform());
		 %dot = VectorDot(%dif,%for);
		 if (%dot > 0) {
		    %col.target.playThread(0,"drop");
		    LocalClientConnection.gemCount++;
		    if (LocalClientConnection.gemCount >= $Game::gemCount) {
		       %col.target.playAudio(0,AllTargetsSfx);
		    }
		    else {
		       %col.target.playAudio(0,TargetSfx);
		    }
		    PlayGui.setGemCount(LocalClientConnection.gemCount);
		    %col.target.mesh1.setTransform("10000 10000 10000 1 0 0 0");
		    %col.target.mesh2.setTransform("10000 10000 10000 1 0 0 0");
		    %col.target.mesh1.clearMovement();
		    %col.target.mesh2.clearMovement();
		 }
      }
   }
   if ((%col = getWord(ContainerRayCast(%origin,VectorAdd(%origin,VectorScale(%dif,2)),$TypeMasks::StaticShapeObjectType),0)) != 0) {
      if (%col.getDataBlock().classname $= "Boards") {
         %obj.setDamageState("Destroyed");
         //echo(%col);
         %obj.startFade(0, 0, true);
         cancel(%obj.delSched);
         %obj.schedule(100,"delete");
         %col.playThread(0,"explode");
         %col.sched1 = %col.schedule(1000,"startFade",0,0,true);
         %col.sched2 = %col.schedule(1000, "hide", true);
      }
   } else if ((%col = getWord(ContainerRayCast(%origin,VectorAdd(%origin,VectorScale(%dif,2)),$TypeMasks::InteriorObjectType),0)) != 0) {
      cancel(%obj.delSched);
      %obj.schedule(100, "delete");
      %obj.setDamageState("Destroyed");
      %obj.startFade(0,0,true); 
      //echo("Bullet " @ %obj.getId() @ " has been deleted because it hit into an interior!");
   } 
}

function onSpawn() {
   if (p().tank !$= "")
      exitTankSpawn();
}

function onAfterSpawn() {
   $Game::GemCount = countTargets(MissionGroup);
   PlayGui.setMaxGems($Game::GemCount);
   call("targetGuiThing");
   schedule(100,0,"targetGuiThing");
}

function Tank::onSpawn(%this,%obj) {
   %obj.getServer().setTransform(%obj.initialTransform);
   %obj.gun.getServer().setTransform(%obj.gun.initialTransform);
}

function Boards::onSpawn(%this,%obj) {
   %obj.hide(false);
   %obj.stopThread(0);
   %obj.startFade(0,0,false);
   cancel(%obj.sched1);
   cancel(%obj.sched2);
}

function Target::onSpawn(%this,%obj) {
   %mat1 = "0 0 2.2 1 0 0 0";
   %mat2 = "0.565686 0 2.43432 0 1 0" SPC $pi/4;
   %obj.stopThread(0);
   %obj.mesh1.setTransform(MatrixMultiply(%obj.getTransform(),%mat1));
   %obj.mesh2.setTransform(MatrixMultiply(%obj.getTransform(),%mat2));
   %obj.mesh1.tetherTo(%obj);
   %obj.mesh2.tetherTo(%obj);
}

function targetGUIThing() {
	HUD_ShowGem.setModel("marble/data/missions/sandbox/Tank/target.dts","");
	HUD_ShowGem.orbitDistance = "6";
}

function countTargets(%group)
{
   // Count up all targets out there are in the world
   %targets = 0;
   for (%i = 0; %i < %group.getCount(); %i++)
   {
      %object = %group.getObject(%i);
      %type = %object.getClassName();
      if (%type $= "SimGroup")
         %targets += countTargets(%object);
      else
         if (%type $= "StaticShape" &&
               %object.getDatablock().classname $= "Target")
            %targets++;
   }
   return %targets;
}
